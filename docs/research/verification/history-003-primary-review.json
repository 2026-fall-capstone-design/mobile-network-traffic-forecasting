  "findings": [
    {
      "claim_id": "H003-C01",
      "sources": [
        "SRC-0020826",
        "SRC-0020785"
      ],
      "finding": "HCP는 알려진 출처의 데이터 집단을 실제 분리/공동 적합한 검증 손실로 병합한다. A2/A3는§1.1이다.",
      "limitation": "시간/cell 의존성 적용·전체 증명·전역 최적성 확인 아님."
    },
    {
      "claim_id": "H003-C02",
      "sources": [
        "SRC-0020826",
        "SRC-0020785"
      ],
      "finding": "HCP Theorem2의 O(N³p²t)는 OLS/RMSE·동일 train t·validation v<t·N−1회 단일 성장 pool 병합이라는 조건의 복잡도다.",
      "limitation": "모든 learner의 실행시간 또는 현 후보의 가속률이 아님."
    },
    {
      "claim_id": "H003-C03",
      "sources": [
        "SRC-0020826",
        "SRC-0020787",
        "SRC-0063481"
      ],
      "finding": "Population-HCP의 posterior 수식/greedy 공동 적합과 실제 OLS/logistic plug-in 실험을 구분한다. 한계는§6.",
      "limitation": "논문 표의 보고값 대조이며 MCMC/모델 재현이나 traffic 보장 아님."
    },
    {
      "claim_id": "H003-C04",
      "sources": [
        "SRC-0020826",
        "SRC-0020785",
        "SRC-0020787",
        "SRC-0063481"
      ],
      "finding": "후속 논문의 HCP2025 observation-level 서술은2025원문과 다르다. Gapminder random split의 local최저 문구도 Table6 mixed-effects2.73/local2.91과 다르다.",
      "limitation": "불일치를 원문별로 보존하며 임의로 합치지 않는다."
    },
    {
      "claim_id": "H003-C05",
      "sources": [
        "SRC-0020826",
        "SRC-0061704"
      ],
      "finding": "RMB-CLE는 교차오차 역수 profile의 cosine/average linkage/silhouette 및 taskID 포함 후속 모델을 쓴다. 제곱손실 분해에는 noise가 남는다.",
      "limitation": "N²는 쌍별 평가 규모 설명. wall-time 보장·Tab MAE 실험·잡음 제거 보장 아님."
    },
    {
      "claim_id": "H003-C06",
      "sources": [
        "SRC-0020826",
        "SRC-0061684"
      ],
      "finding": "ETAP는 학습 gradient와 실제 group별 MTL gain으로 spline/ridge 잔차를 학습한다. group 선택은§3.2.3.",
      "limitation": "최종 learner 정보가 필요한 방법. RCTL 독립 규칙이 같은 정보를 확보했다는 근거 아님."
    },
    {
      "claim_id": "H003-C07",
      "sources": [
        "SRC-0020826",
        "EXT-H003-05"
      ],
      "finding": "Bolfarine외는 reference posterior predictive를 저차원 밀도와 개별 관측의 cluster 요약으로 투영한다.",
      "limitation": "cell별 조건부 회귀자료 공유 또는 RCTL을 직접 최적화한 실험 아님."
    },
    {
      "claim_id": "H003-C08",
      "sources": [
        "SRC-0020826"
      ],
      "finding": "05의 후보 검토 문구를 당시 기록으로 보존하고04/06/07및08/09의 검수된 기각/후속 진단에 연결한다. 나머지05비교는 미통합.",
      "limitation": "정리된 다섯 문헌은 전수 신규성 조사/전체05완료/새실험이 아님."
    }
  ],
