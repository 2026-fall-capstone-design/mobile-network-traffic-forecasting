    {
      "source_id": "SRC-0001476",
      "source_sha256": "3ce9b88042eb8aba24977f72acf70c32435a79bb2fae7f8f2ec7882a54d27940",
      "line": 17,
      "decision": "합계·대표예측으로cell복원",
      "original_records": "48–50",
      "historical_judgment": "true future 합계 성능은실행가능예측아님. 같은비용의lastvalue항등식·기존대표예측과중복을확인한다.",
      "record_path": "../../records/0048-0049-aggregation-recovery.md",
