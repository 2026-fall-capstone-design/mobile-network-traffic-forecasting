      "source_sha256": "3ce9b88042eb8aba24977f72acf70c32435a79bb2fae7f8f2ec7882a54d27940",
      "line": 19,
      "decision": "baseline·residual·조건부분포변환",
      "original_records": "63–65",
      "historical_judgment": "자체기존구조이며변환MAE와원단위MAE는같지않다. 피팅하기쉬운target이남는직접근거필요.",
      "record_path": "../../records/0063-0065-synthesis.md",
      "record_sha256": "f1f815bc7eba2b14891ef2ceb048b8e776187816188a56ff4b729102e372e770",
      "new_in_snapshot25": false,
