      "line": 13,
      "decision": "학습 sample 압축",
      "original_records": "56–58",
      "historical_judgment": "loss 중요도는 gradient효율과 다름. BN의batch의존성도 있다.",
      "record_path": "../../records/0056-0058-mae-sampling.md",
