{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "n_points",
          "n_cells",
          "mae",
          "rmse",
          "macro_rmse"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "n_points": {
            "type": "integer",
            "minimum": 1
          },
          "n_cells": {
            "type": "integer",
            "minimum": 1
          },
          "mae": {
            "type": "number",
            "minimum": 0
          },
          "rmse": {
            "type": "number",
            "minimum": 0
          },
          "macro_rmse": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
