{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "unit",
        "timezone",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "kind": {
          "enum": [
            "synthetic",
            "real"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "const": "UTC"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "test_start",
          "test_end",
          "generated_at",
          "provenance",
          "metrics_path",
          "models"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "test_start": {
            "type": "string",
            "format": "date-time"
          },
          "test_end": {
            "type": "string",
            "format": "date-time"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commit",
              "dirty",
              "python",
              "data_sha256",
              "config_sha256"
            ],
            "properties": {
              "commit": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{40}$"
              },
              "dirty": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "python": {
                "type": "string",
                "minLength": 1
              },
              "data_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "config_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "metrics_path": {
            "type": "string",
            "minLength": 1
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "series"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "series": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "cell_id",
                      "path"
                    ],
                    "properties": {
                      "cell_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
